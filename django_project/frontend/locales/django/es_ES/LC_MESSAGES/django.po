#: geosight/data/services/dashboard_service.py
msgid "Must be valid JSON."
msgstr "Debe ser un JSON válido."

#: geosight/data/services/dashboard_service.py
msgid "Must be an object."
msgstr "Debe ser un objeto."

#: geosight/data/services/dashboard_service.py
msgid "Must be a list."
msgstr "Debe ser una lista."

#: geosight/data/services/dashboard_service.py
#, python-format
msgid "%(model)s %(id)s does not exist."
