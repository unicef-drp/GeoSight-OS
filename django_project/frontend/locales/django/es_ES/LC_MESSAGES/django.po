#: geosight/data/services/dashboard_service.py
msgid "Must be the identifier as a string."
msgstr "Debe ser el identificador como texto."

#: geosight/data/services/dashboard_service.py
msgid "Must not be empty."
msgstr "No puede estar vacío."

#: geosight/data/services/dashboard_service.py
msgid "Must be an integer id."
msgstr "Debe ser un id entero."

#: geosight/data/services/dashboard_service.py
